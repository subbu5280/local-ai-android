<?xml version="1.0" encoding="utf-8"?>
<!-- M8: no app data leaves the phone through Android's cloud backup or device-to-device transfer. Chats, documents,
     coding proposals and models are only copied out by the app's own password-encrypted backup (src/backup/).
     (On Android 12+, android:allowBackup="false" alone does not stop device-to-device transfer.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
